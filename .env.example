# Copy this file to .env and fill in the values for your environment.
# For dev overrides, copy to .env.local (gitignored).

# ── Environment ────────────────────────────────────────────────────────────────
# Values: development | staging | production
EXPO_PUBLIC_ENVIRONMENT=development

# ── API ────────────────────────────────────────────────────────────────────────
# Production:  https://api.webuddhist.com/api/v1
# Staging:     https://webuddhist-tst-backend.onrender.com/api/v1
# Dev:         https://webuddhist-dev-backend.onrender.com/api/v1
EXPO_PUBLIC_API_URL=https://api.webuddhist.com/api/v1

# AI chat service
# Production:  https://aichat.webuddhist.com
# Staging:     https://test-aichat.onrender.com
# Dev:         https://at-chat-20299882697-4758f1e.onrender.com
EXPO_PUBLIC_AI_URL=https://aichat.webuddhist.com

# ── Auth0 ──────────────────────────────────────────────────────────────────────
EXPO_PUBLIC_AUTH0_DOMAIN=we-buddhist-prod.us.auth0.com
EXPO_PUBLIC_AUTH0_CLIENT_ID=your_native_app_client_id
# Optional — may be required for token audience validation
# EXPO_PUBLIC_AUTH0_AUDIENCE=

# ── PostHog analytics (optional — omit or leave blank to disable) ──────────────
# EXPO_PUBLIC_POSTHOG_API_KEY=
# EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
