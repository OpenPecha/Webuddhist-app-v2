# Copy this file to .env and fill in the values for your environment.
# For dev overrides, copy to .env.local (gitignored).

# ── Environment ────────────────────────────────────────────────────────────────
# Values: development | staging | production
EXPO_PUBLIC_ENVIRONMENT=development

# ── API ────────────────────────────────────────────────────────────────────────
# Production:  https://api.webuddhist.com/api/v1
# Staging:     https://webuddhist-tst-backend.onrender.com/api/v1
# Dev:         https://webuddhist-dev-backend.onrender.com/api/v1
EXPO_PUBLIC_API_URL=https://webuddhist-dev-backend.onrender.com/api/v1

# AI chat service
# Production:  https://aichat.webuddhist.com
# Staging:     https://test-aichat.onrender.com
# Dev:         https://at-chat-20299882697-4758f1e.onrender.com
EXPO_PUBLIC_AI_URL=https://aichat.webuddhist.com

# ── Auth0 (hardcoded per app id in src/config/auth0.ts) ───────────────────────
# org.pecha.app.dev → 87AXZOsI on dev-vz6o17. Env vars are fallback only.
EXPO_PUBLIC_AUTH0_DOMAIN=dev-vz6o17motc18g45h.us.auth0.com
EXPO_PUBLIC_AUTH0_CLIENT_ID=87AXZOsIWFIsjnQX8z3PovGBpEDSu9vZ
# Optional — may be required for token audience validation
# EXPO_PUBLIC_AUTH0_AUDIENCE=
#
# App IDs (set in app.config.js via APP_VARIANT / EAS profile):
#   development / preview → org.pecha.app.dev
#   production            → org.pecha.app (Play Store / Flutter replacement)
#
# Auth0 callback / logout URLs (Native app) — replace {DOMAIN} with EXPO_PUBLIC_AUTH0_DOMAIN:
#   Dev Android:  org.pecha.app.dev://{DOMAIN}/android/org.pecha.app.dev/callback
#   Dev iOS:      org.pecha.app.dev://{DOMAIN}/ios/org.pecha.app.dev/callback
#   Prod Android: org.pecha.app://{DOMAIN}/android/org.pecha.app/callback
#   Prod iOS:     org.pecha.app://{DOMAIN}/ios/org.pecha.app/callback
#
# DOMAIN in native plugin, .env, and Auth0 dashboard must all match. Rebuild after changes.

# ── PostHog analytics (optional — omit or leave blank to disable) ──────────────
# EXPO_PUBLIC_POSTHOG_API_KEY=
# EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
